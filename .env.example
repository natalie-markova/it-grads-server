# Development Environment Variables для IT-Grads
# ВАЖНО: Скопируйте этот файл в .env и заполните реальными значениями

# Database
DATABASE_URL=postgres://username:password@host:5432/database_name
NODE_ENV=development

# Server
PORT=5001

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_REFRESH_SECRET=your_refresh_secret_key_here
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Domain
DOMAIN=localhost

# Cloudflare R2 (опционально)
# CLOUDFLARE_ACCOUNT_ID=your_account_id
# CLOUDFLARE_API_TOKEN=your_api_token
# R2_BUCKET_NAME=your_bucket_name
# R2_PUBLIC_URL=https://pub-your_account_id.r2.dev

# YandexGPT API
YANDEX_API_KEY=your_yandex_api_key_here
YANDEX_FOLDER_ID=your_yandex_folder_id_here
YANDEX_API_URL=https://llm.api.cloud.yandex.net/foundationModels/v1/completion

# Yandex SMTP для отправки email
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_email@yandex.ru
SMTP_PASS=your_smtp_password_here

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here