# Production Environment Variables для IT-Grads
# ВАЖНО: Скопируйте этот файл в .env.production и заполните реальными значениями

# Server Configuration
NODE_ENV=production
PORT=5001

# Database Configuration (Удаленный DB Server: 185.55.56.52)
DATABASE_URL=postgres://postgres:itgrads2024@185.55.56.52:5432/postgres

# JWT Configuration
JWT_SECRET=your_jwt_secret_key_here_change_in_production
JWT_REFRESH_SECRET=your_refresh_secret_key_here_change_in_production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Domain Configuration
DOMAIN=www.itgrads.ru

# Cloudflare R2 (опционально)
# CLOUDFLARE_ACCOUNT_ID=your_account_id
# CLOUDFLARE_API_TOKEN=your_api_token
# R2_BUCKET_NAME=your_bucket_name
# R2_PUBLIC_URL=https://pub-your_account_id.r2.dev

# YandexGPT API
YANDEX_API_KEY=your_yandex_api_key_here
YANDEX_FOLDER_ID=your_yandex_folder_id_here
YANDEX_API_URL=https://llm.api.cloud.yandex.net/foundationModels/v1/completion

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

